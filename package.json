{
  "name": "marcfors.com",
  "version": "0.4.2",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prebuild": "node scripts/audit-snapshot.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "privacy": "node scripts/check-privacy.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run privacy && npm test && npm run typecheck && npm run lint && npm run audit && npm run build"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
